datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  VISITEUR
  AGENT
  OFFICIER
  ADMIN
  MAGISTRAT
  AVOCAT
}

enum Grade {
  GAV
  GENDARME
  MDL_CHEF
  ADJUDANT
  ADJUDANT_CHEF
  MAJOR
  LIEUTENANT
  CAPITAINE
  COMMANDANT
  LIEUTENANT_COLONEL
  COLONEL
  // Police Nationale - Corps d'application et d'encadrement
  POLICIER_ADJOINT
  GARDIEN_DE_LA_PAIX
  BRIGADIER_CHEF_POLICE
  MAJOR_POLICE
  MAJOR_RULP
  // Police Nationale - Corps de commandement
  CAPITAINE_POLICE
  COMMANDANT_POLICE
  COMMANDANT_DIVISIONNAIRE
  COMMANDANT_DIV_EF
  // Police Nationale - Corps de conception et de direction
  COMMISSAIRE_POLICE
  COMMISSAIRE_DIVISIONNAIRE
  COMMISSAIRE_GENERAL
  CONTROLEUR_GENERAL
  INSPECTEUR_GENERAL
  DGPN
  // Justice & Tribunal - Magistrats & Auxiliaires de justice
  PROCUREUR
  PROCUREUR_ADJOINT
  SUBSTITUT_PROCUREUR
  JUGE_INSTRUCTION
  JUGE_LIBERTES
  JUGE_ENFANTS
  JUGE_SIEGE
  PRESIDENT_TRIBUNAL
  AVOCAT_BARREAU
  BATONNIER
  GREFFIER_TRIBUNAL
}

enum StatutActivite {
  ACTIF
  EN_CONGE
  DETACHE
  SUSPENDU
  RADIE
}

enum QualifJudiciaire {
  AUCUNE
  APJ21
  APJ20
  OPJ
  MAGISTRAT
  AVOCAT
}

enum TypeUnite {
  BRIGADE
  BR
  PSIG
  GROUPEMENT
  COMMISSARIAT
  BAC
  PJ
  CRS
  DIPN
  TRIBUNAL_JUDICIAIRE
  PARQUET
  CABINET_INSTRUCTION
  BARREAU_AVOCATS
}

enum StatutDemandeAcces {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

enum HabilitationType {
  FICHIERS_CONFIDENTIELS
  ARMURERIE
  OPJ
  APJ
}

enum HabilitationStatut {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

enum TypeDossier {
  FLAGRANT_DELIT
  ENQUETE_PRELIMINAIRE
  INTERVENTION
  COMMISSION_ROGATOIRE
}

enum ProcedureStatut {
  OUVERTE
  TRANSMISE_PARQUET
  CLASSEE
}

enum Classification {
  NON_PROTEGE
  DIFFUSION_RESTREINTE
}

enum OffreType {
  GAV
  SOUS_OFFICIER
  OFFICIER
}

enum EtapeCandidature {
  DOSSIER_RECU
  EPREUVES
  VISITE_MEDICALE
  RETENU
  NON_RETENU
}

// -------------------------------------------------------------
// MODÈLES PRINCIPAUX
// -------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?   // Optionnel si authentification via OIDC / SSO d'État (FranceConnect / AgentConnect)
  role         Role      @default(AGENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agent        Agent?
  auditLogs    AuditLog[]

  @@map("users")
}

model Unite {
  id        String     @id @default(uuid())
  code      String     @unique // Code unité (ex: 4512)
  nom       String
  type      TypeUnite
  createdAt DateTime   @default(now())

  agents     Agent[]
  procedures Procedure[]
  prePlaintes PrePlainte[]

  @@map("unites")
}

model Agent {
  id                 String           @id @default(uuid())
  matricule          String           @unique // 6 chiffres (ex: 245781) ou RIO Police (7 chiffres)
  institution        String           @default("GENDARMERIE") // GENDARMERIE ou POLICE_NATIONALE
  nom                String
  prenom             String
  grade              Grade
  affectation        String
  statut             StatutActivite   @default(ACTIF)
  qualification      QualifJudiciaire @default(AUCUNE)
  identifiant        String?
  motDePasse         String?
  dateIncorporation  DateTime
  dateRevocation     DateTime?
  motifRevocation    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  uniteId            String
  unite              Unite            @relation(fields: [uniteId], references: [id])

  demandes           DemandeHabilitation[] @relation("DemandesFaites")
  proceduresRedigees Procedure[]           @relation("RedacteurProcedure")
  proceduresValidees Procedure[]           @relation("ValidateurProcedure")
  rapports           RapportProcedure[]

  @@index([uniteId])
  @@index([matricule])
  @@map("agents")
}

model DemandeHabilitation {
  id          String             @id @default(uuid())
  reference   String             @unique // Ex: HAB-2026-0141
  type        HabilitationType
  motif       String             @db.Text
  dureeMois   Int                @default(6) // 0 = permanente
  statut      HabilitationStatut @default(EN_ATTENTE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  demandeurId String
  demandeur   Agent              @relation("DemandesFaites", fields: [demandeurId], references: [id])

  historique  HistoriqueHabilitation[]

  @@index([demandeurId])
  @@index([statut])
  @@map("demandes_habilitation")
}

model HistoriqueHabilitation {
  id          String              @id @default(uuid())
  date        DateTime            @default(now())
  action      String
  commentaire String?             @db.Text
  acteurId    String

  demandeId   String
  demande     DemandeHabilitation @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  @@map("historique_habilitations")
}

model Procedure {
  id             String          @id @default(uuid())
  numeroPV       String          @unique // Ex: 4512/00341/2026
  dateFaits      DateTime
  dateOuverture  DateTime        @default(now())
  type           TypeDossier
  qualification  String
  lieu           String
  resume         String          @db.Text
  statut         ProcedureStatut @default(OUVERTE)
  classification Classification  @default(DIFFUSION_RESTREINTE)
  parquet        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  redacteurId    String
  redacteur      Agent           @relation("RedacteurProcedure", fields: [redacteurId], references: [id])

  uniteId        String
  unite          Unite           @relation(fields: [uniteId], references: [id])

  valideParId    String?
  validePar      Agent?          @relation("ValidateurProcedure", fields: [valideParId], references: [id])

  rapports       RapportProcedure[]
  auditions      Audition[]
  historique     HistoriqueProcedure[]

  @@index([uniteId])
  @@index([redacteurId])
  @@index([statut])
  @@index([dateFaits])
  @@map("procedures")
}

model RapportProcedure {
  id          String    @id @default(uuid())
  contenu     String    @db.Text
  date        DateTime  @default(now())

  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  auteurId    String
  auteur      Agent     @relation(fields: [auteurId], references: [id])

  @@map("rapports_procedure")
}

enum TypeAudition {
  VICTIME_PLAINTE
  TEMOIN
  MIS_EN_CAUSE_LIBRE
  GARDE_A_VUE
}

model Audition {
  id               String        @id @default(uuid())
  numeroPV         String        // Ex: 4512/00341-AUD-1
  typeAudition     TypeAudition  @default(VICTIME_PLAINTE)
  dateDebut        DateTime      @default(now())
  dateFin          DateTime?
  lieu             String        // Ex: Dans les locaux de la BTA de Valmont-sur-Loire
  cadreLegal       TypeDossier   // Enquête préliminaire, Flagrant délit...

  // Personne auditionnée
  nom              String
  nomUsage         String?
  prenom           String
  dateNaissance    DateTime?
  lieuNaissance    String?
  nationalite      String        @default("Française")
  profession       String?
  domicile         String
  telephone        String?
  email            String?

  // Droits & formalités
  droitsNotifies   Boolean       @default(true)
  avocatDemande    Boolean       @default(false)
  avocatNom        String?
  interprete       Boolean       @default(false)
  plainteDeposee   Boolean       @default(false)
  prejudiceChiffre Float?

  // Corps de l'audition (procès-verbal intégral conforme style officiel)
  declarations     String        @db.Text

  // Enquêteur qui a procédé à l'audition
  enqueteurId      String
  enqueteurNom     String
  enqueteurGrade   String
  enqueteurQualif  String        // OPJ, APJ, APJA

  procedureId      String
  procedure        Procedure     @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([procedureId])
  @@index([typeAudition])
  @@map("auditions")
}

model HistoriqueProcedure {
  id          String    @id @default(uuid())
  date        DateTime  @default(now())
  action      String
  commentaire String?   @db.Text
  acteurId    String

  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@map("historique_procedures")
}

model Candidature {
  id            String           @id @default(uuid())
  reference     String           @unique // Ex: CAND-2026-0412
  offre         OffreType
  nom           String
  prenom        String
  email         String
  dateNaissance DateTime
  niveauEtudes  String
  etape         EtapeCandidature @default(DOSSIER_RECU)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  historique    HistoriqueCandidature[]

  @@index([offre])
  @@index([etape])
  @@map("candidatures")
}

model HistoriqueCandidature {
  id            String      @id @default(uuid())
  date          DateTime    @default(now())
  action        String
  commentaire   String?     @db.Text
  acteurId      String?

  candidatureId String
  candidature   Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  @@map("historique_candidatures")
}

// -------------------------------------------------------------
// SÉCURITÉ & AUDIT (Chaîne cryptographique)
// -------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  action    String
  cible     String
  ip        String
  prevHash  String
  hash      String

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([date])
  @@index([action])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// MODULE DE PRÉ-PLAINTE EN LIGNE (Conforme cadre officiel)
// -------------------------------------------------------------

enum StatutPrePlainte {
  DEPOSEE
  PRISE_EN_CHARGE
  CONVOQUEE
  TRANSFORMEE_EN_PV
  CLASSEE_SANS_SUITE
}

enum TypeInfractionPrePlainte {
  VOL_SIMPLE
  VOL_EFFRACTION
  VOL_VEHICULE
  DEGRADATION_BIEN
  ESCROQUERIE
  ABUS_CONFIANCE
  AUTRE_ATTEINTE_BIENS
}

model PrePlainte {
  id               String                   @id @default(uuid())
  numeroDossier    String                   @unique // Ex: PP-2026-0814
  typeInfraction   TypeInfractionPrePlainte
  dateFaits        DateTime
  lieuFaits        String
  description      String                   @db.Text
  auteurInconnu    Boolean                  @default(true) // Pré-plainte requiert légalement un auteur inconnu
  prejudiceEstime  Float?
  statut           StatutPrePlainte         @default(DEPOSEE)
  dateRdv          DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  // Données de la victime / plaignant
  victimeNom       String
  victimePrenom    String
  victimeEmail     String
  victimeTelephone String
  victimeAdresse   String

  // Unité territoriale saisie
  uniteId          String
  unite            Unite                    @relation(fields: [uniteId], references: [id])

  // Agent instructeur éventuel
  agentId          String?

  @@index([uniteId])
  @@index([statut])
  @@index([numeroDossier])
  @@map("pre_plaintes")
}

model DemandeAcces {
  id                String             @id @default(uuid())
  reference         String             @unique // Ex: ACC-2026-0001
  institution       String             @default("GENDARMERIE") // GENDARMERIE ou POLICE_NATIONALE
  matricule         String
  nom               String
  prenom            String
  grade             Grade
  uniteId           String
  affectation       String
  qualification     QualifJudiciaire   @default(APJ20)
  email             String
  motif             String             @db.Text
  statut            StatutDemandeAcces @default(EN_ATTENTE)
  reponseComment    String?            @db.Text
  traiteParId       String?
  motDePasseInitial String?
  roleAttribue      Role?              @default(AGENT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([statut])
  @@index([matricule])
  @@index([institution])
  @@map("demandes_acces")
}

